{
	"name": "portifolio-server",
	"version": "1.0.0",
	"description": "Backend server for my portifolio",
	"main": "dist/server.js",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "tsx --env-file=.env --watch src/server.ts",
		"build": "npx prisma generate && tsc",
		"start": "node --env-file=.env dist/server.js",
		"db:migrate": "mkdir db && touch db/database.db && npx prisma migrate deploy",
		"db:seed": "tsx prisma/seed.ts",
		"test:unit": "vitest -c vitest.unit.config.ts",
		"test:integration": "vitest -c vitest.integration.config.ts"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jpedroccruz/portifolio-server.git"
	},
	"author": "jpedroccruz",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/jpedroccruz/portifolio-server/issues"
	},
	"homepage": "https://github.com/jpedroccruz/portifolio-server#readme",
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@scalar/fastify-api-reference": "^1.77.0",
		"@types/node": "25.9.3",
		"@types/supertest": "7.2.1",
		"@vitest/coverage-v8": "^4.1.12",
		"pino-pretty": "13.1.3",
		"prisma": "6.19.3",
		"supertest": "7.2.2",
		"tsx": "4.22.4",
		"typescript": "6.0.3",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@fastify/cookie": "11.1.2",
		"@fastify/cors": "11.2.0",
		"@fastify/jwt": "10.1.0",
		"@fastify/swagger": "9.8.1",
		"@fastify/swagger-ui": "6.1.1",
		"@prisma/client": "6.19.3",
		"bcryptjs": "3.0.3",
		"fastify": "^5.12.8",
		"fastify-type-provider-zod": "6.1.0",
		"postgres": "3.4.9",
		"resend": "6.17.2",
		"zod": "^4.6.7"
	},
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
